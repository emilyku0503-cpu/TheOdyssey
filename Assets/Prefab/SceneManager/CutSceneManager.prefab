  dialoguePanel: {fileID: 8311860497586177825}
  typingSpeed: 0.08
  autoAdvanceDelay: 2
  dialogueDuration: 5
  dialogues:
  - image: {fileID: 21300000, guid: cbf8b79ddf725d947876c59d0fd31dae, type: 3}
    dialogue: Odyssey is a king of Ithaca.
    sound: {fileID: 8300000, guid: 0938407c33dc0844f871fbf8e35c33c3, type: 3}
  - image: {fileID: 21300000, guid: f5137ec9478b41d45ac4fbb2b51c7aa3, type: 3}
    dialogue: Odysseus fought in the Trojan War and helped lead the Greeks to victory.
    sound: {fileID: 8300000, guid: 7433d2d0f7433b84a80bf0ba30573353, type: 3}
  - image: {fileID: 21300000, guid: fcbcf2c21785d894f8f37b1046d6977a, type: 3}
    dialogue: "On his way home to Ithaca, a violent storm destroyed his ship, \nkilling
      his crew and leaving him stranded at sea."
    sound: {fileID: 8300000, guid: 26825d544f253d347b18bcfd2926b856, type: 3}
  - image: {fileID: 21300000, guid: cbf8b79ddf725d947876c59d0fd31dae, type: 3}
    dialogue: Now alone, he must overcome dangerous trials and find his way back
      to Ithaca.
    sound: {fileID: 8300000, guid: 0938407c33dc0844f871fbf8e35c33c3, type: 3}
  transitionPanel: {fileID: 907146889399384227}
  transitionPlayer: {fileID: 7929360353141944816}
